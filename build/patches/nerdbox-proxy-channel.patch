+package task
+
+import (
+	"testing"
+)
+
+func TestParseProxyChannel(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		value string
+		port  uint32
+		ok    bool
+	}{
+		{name: "valid", value: "port=1027,socket=/tmp/proxy.sock", port: 1027, ok: true},
+		{name: "high port", value: "port=1126,socket=/run/klorq/proxy.sock", port: 1126, ok: true},
+		{name: "shim rpc port reserved", value: "port=1025,socket=/tmp/proxy.sock"},
+		{name: "stream port reserved", value: "port=1026,socket=/tmp/proxy.sock"},
+		{name: "missing port", value: "socket=/tmp/proxy.sock"},
+		{name: "relative socket", value: "port=1027,socket=proxy.sock"},
+		{name: "unknown field", value: "port=1027,socket=/tmp/proxy.sock,extra=1"},
+		{name: "malformed field", value: "port=1027,socket"},
+		{name: "bad port", value: "port=abc,socket=/tmp/proxy.sock"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			channel, err := parseProxyChannel(tc.value)
+			if (err == nil) != tc.ok {
+				t.Fatalf("parseProxyChannel(%q) error = %v, want ok=%v", tc.value, err, tc.ok)
+			}
+			if tc.ok && (channel.Port != tc.port || channel.Socket == "") {
+				t.Fatalf("parsed channel = %+v", channel)
+			}
+		})
+	}
+}
