+
+package task
+
+import (
+	"errors"
+	"fmt"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/containerd/nerdbox/internal/shim/sandbox"
+	"github.com/containerd/nerdbox/internal/shim/task/bundle"
+)
+
+// proxyChannelAnnotation configures an extra guest-dialed vsock port that
+// libkrun bridges to a host unix socket owned by the Klorq proxy broker.
+// The value is a comma-separated list of key=value fields:
+//
+//	io.klorq.proxy=port=1027,socket=/abs/path/proxy.sock
+//
+// The annotation is consumed by the shim and never forwarded into the guest.
+const proxyChannelAnnotation = "io.klorq.proxy"
+
+func proxyChannelFromBundle(b *bundle.Bundle) (*sandbox.ProxyChannel, error) {
+	value, ok := b.Spec.Annotations[proxyChannelAnnotation]
+	if !ok {
+		return nil, nil
+	}
+	delete(b.Spec.Annotations, proxyChannelAnnotation)
+	return parseProxyChannel(value)
+}
+
+func parseProxyChannel(value string) (*sandbox.ProxyChannel, error) {
+	var port uint32
+	var socket string
+	for _, field := range strings.Split(value, ",") {
+		key, raw, ok := strings.Cut(strings.TrimSpace(field), "=")
+		if !ok {
+			return nil, fmt.Errorf("invalid proxy channel field %q", field)
+		}
+		switch strings.TrimSpace(key) {
+		case "port":
+			parsed, err := strconv.ParseUint(strings.TrimSpace(raw), 10, 32)
+			if err != nil {
+				return nil, fmt.Errorf("invalid proxy channel port: %w", err)
+			}
+			port = uint32(parsed)
+		case "socket":
+			socket = strings.TrimSpace(raw)
+		default:
+			return nil, fmt.Errorf("unknown proxy channel field %q", key)
+		}
+	}
+	// Ports below 1027 belong to the nerdbox shim (1025 rpc, 1026 stream).
+	if port < 1027 {
+		return nil, errors.New("proxy channel port must be 1027 or higher")
+	}
+	if socket == "" || !filepath.IsAbs(socket) {
+		return nil, errors.New("proxy channel socket must be an absolute path")
+	}
+	return &sandbox.ProxyChannel{Port: port, Socket: socket}, nil
+}
