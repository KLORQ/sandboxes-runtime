+// AddProxyChannel registers a guest-dialed vsock port bridged to a host unix
+// socket in connect mode. Must be called before Start.
+func (v *vmInstance) AddProxyChannel(_ context.Context, port uint32, socketPath string) error {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	if v.client != nil {
+		return errors.New("VM already started")
+	}
+	if port < 1027 || socketPath == "" {
+		return fmt.Errorf("invalid proxy channel port=%d socket=%q", port, socketPath)
+	}
+	v.proxyPort = port
+	v.proxyPath = socketPath
+	return nil
+}
