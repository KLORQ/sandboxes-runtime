index 0000000..f720f19
--- /dev/null
+++ b/pkg/services/dns/egress_policy_test.go
@@ -0,0 +1,38 @@
+package dns
+
+import (
+	"net"
+	"testing"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+	"github.com/miekg/dns"
+)
+
+func TestEgressPolicyBlocksExternalDNSFallback(t *testing.T) {
+	h := &dnsHandler{allowUpstream: false}
+	m := new(dns.Msg)
+	m.SetQuestion("example.invalid.", dns.TypeA)
+	h.addAnswers(m)
+	if m.Rcode != dns.RcodeRefused {
+		t.Fatalf("got Rcode %d, want REFUSED", m.Rcode)
+	}
+	if len(m.Answer) != 0 {
+		t.Fatalf("got unexpected external answer: %v", m.Answer)
+	}
+}
+
+func TestEgressPolicyKeepsLocalDNSZones(t *testing.T) {
+	h := &dnsHandler{
+		allowUpstream: false,
+		zones: []types.Zone{{
+			Name:      "internal.",
+			DefaultIP: net.ParseIP("192.168.127.1"),
+		}},
+	}
+	m := new(dns.Msg)
+	m.SetQuestion("host.internal.", dns.TypeA)
+	h.addAnswers(m)
+	if m.Rcode != dns.RcodeSuccess || len(m.Answer) != 1 {
+		t.Fatalf("got rcode=%d answers=%v, want local A answer", m.Rcode, m.Answer)
+	}
+}
diff --git a/pkg/services/dns/policy_dns.go b/pkg/services/dns/policy_dns.go
new file mode 100644
index 0000000..b651e7c
--- /dev/null
+++ b/pkg/services/dns/policy_dns.go
@@ -0,0 +1,191 @@
+package dns
+
+import (
+	"fmt"
+	"net"
+	"strings"
+	"time"
+
+	"github.com/miekg/dns"
+)
+
+const maxPolicyCNAMEs = 16
+const maxPolicyDNSRecords = 256
+
+// addPolicyIPAnswers uses only the configured resolver: net.Resolver discards
+// TTL and can silently consult a different host resolver for other queries.
+func (h *dnsHandler) addPolicyIPAnswers(m *dns.Msg, q dns.Question) {
+	family := 4
+	if q.Qtype == dns.TypeAAAA {
+		family = 6
+	}
+	generation := h.policy.BeginDNS(q.Name, family)
+	if generation == 0 {
+		m.Rcode = dns.RcodeServerFailure
+		return
+	}
+	clear := func() bool { return h.policy.CommitDNS(q.Name, nil, 0, family, generation) }
+	fail := func(code int) { clear(); m.Answer = nil; m.Rcode = code }
+	if h.policyUpstream == "" || q.Qclass != dns.ClassINET {
+		fail(dns.RcodeServerFailure)
+		return
+	}
+	current := dns.Fqdn(strings.ToLower(q.Name))
+	seen := make(map[string]bool)
+	validUntil := time.Now().Add(10 * time.Minute)
+	var answers []dns.RR
+	var addresses []net.IPAddr
+	for depth := 0; depth <= maxPolicyCNAMEs; depth++ {
+		if seen[current] || h.policy.DNSDenied(current) {
+			fail(dns.RcodeRefused)
+			return
+		}
+		seen[current] = true
+		req := new(dns.Msg)
+		req.SetQuestion(current, q.Qtype)
+		resp, err := h.exchangePolicyDNS(req)
+		responseTime := time.Now()
+		includeTTL := func(ttl uint32) {
+			if until := responseTime.Add(time.Duration(ttl) * time.Second); until.Before(validUntil) {
+				validUntil = until
+			}
+		}
+		if err != nil || resp == nil || !resp.Response || resp.Truncated || len(resp.Question) != 1 || !strings.EqualFold(resp.Question[0].Name, current) || resp.Question[0].Qtype != q.Qtype || resp.Question[0].Qclass != dns.ClassINET || len(resp.Answer) > maxPolicyDNSRecords {
+			fail(dns.RcodeServerFailure)
+			return
+		}
+		if resp.Rcode != dns.RcodeSuccess {
+			fail(resp.Rcode)
+			return
+		}
+		// Follow only records reachable from the requested owner. An answer can
+		// contain a whole chain, or just a CNAME requiring another query.
+		follow := current
+		for {
+			alias, found, parseErr := policyRRs(resp.Answer, follow, family)
+			if parseErr != nil {
+				fail(dns.RcodeServerFailure)
+				return
+			}
+			if len(found) != 0 {
+				for _, rr := range found {
+					includeTTL(rr.Header().Ttl)
+					switch v := rr.(type) {
+					case *dns.A:
+						addresses = append(addresses, net.IPAddr{IP: v.A})
+					case *dns.AAAA:
+						addresses = append(addresses, net.IPAddr{IP: v.AAAA})
+					}
+					answers = append(answers, rr)
+				}
+				aliases := make([]string, 0, len(seen))
+				for alias := range seen {
+					if !strings.EqualFold(alias, q.Name) {
+						aliases = append(aliases, alias)
+					}
+				}
+				if !h.policy.CommitDNS(q.Name, addresses, time.Until(validUntil), family, generation, aliases...) {
+					fail(dns.RcodeServerFailure)
+					return
+				}
+				m.Answer = append(m.Answer, answers...)
+				return
+			}
+			if alias == nil {
+				if follow == current {
+					if !clear() {
+						fail(dns.RcodeServerFailure)
+						return
+					}
+					m.Answer = append(m.Answer, answers...)
+					return
+				}
+				current = follow
+				break
+			}
+			target := dns.Fqdn(strings.ToLower(alias.Target))
+			if _, ok := dns.IsDomainName(target); !ok || seen[target] || h.policy.DNSDenied(target) || len(seen) >= maxPolicyCNAMEs {
+				fail(dns.RcodeRefused)
+				return
+			}
+			includeTTL(alias.Hdr.Ttl)
+			answers = append(answers, alias)
+			seen[target] = true
+			follow = target
+		}
+		// The target has not actually been queried yet; let the outer loop own it.
+		delete(seen, current)
+	}
+	fail(dns.RcodeServerFailure)
+}
+
+// exchangePolicyDNS retries truncated UDP responses over TCP to the same
+// configured upstream. It never falls back to a host nameserver.
+func (h *dnsHandler) exchangePolicyDNS(req *dns.Msg) (*dns.Msg, error) {
+	if h.client == nil || h.policyUpstream == "" {
+		return nil, fmt.Errorf("policy DNS upstream unavailable")
+	}
+	resp, _, err := h.client.Exchange(req, h.policyUpstream)
+	if err != nil || resp == nil {
+		return nil, fmt.Errorf("policy DNS exchange failed: %v", err)
+	}
+	if !resp.Truncated {
+		return resp, nil
+	}
+	if !resp.Response || len(resp.Question) != 1 || len(req.Question) != 1 || !strings.EqualFold(resp.Question[0].Name, req.Question[0].Name) || resp.Question[0].Qtype != req.Question[0].Qtype || resp.Question[0].Qclass != req.Question[0].Qclass {
+		return nil, fmt.Errorf("invalid truncated DNS response")
+	}
+	tcp := *h.client
+	tcp.Net = "tcp"
+	resp, _, err = tcp.Exchange(req, h.policyUpstream)
+	if err != nil || resp == nil || resp.Truncated {
+		return nil, fmt.Errorf("policy DNS TCP retry failed: %v", err)
+	}
+	return resp, nil
+}
+
+// policyRRs extracts only records belonging to one reachable CNAME owner.
+func policyRRs(records []dns.RR, owner string, family int) (*dns.CNAME, []dns.RR, error) {
+	if len(records) > maxPolicyDNSRecords || (family != 4 && family != 6) {
+		return nil, nil, fmt.Errorf("invalid DNS record set")
+	}
+	var alias *dns.CNAME
+	var found []dns.RR
+	for _, rr := range records {
+		if rr == nil || !strings.EqualFold(rr.Header().Name, owner) || rr.Header().Class != dns.ClassINET {
+			continue
+		}
+		switch v := rr.(type) {
+		case *dns.CNAME:
+			if alias != nil {
+				return nil, nil, fmt.Errorf("multiple CNAME records")
+			}
+			alias = v
+		case *dns.A:
+			if family == 4 && v.A.To4() != nil {
+				found = append(found, rr)
+			}
+		case *dns.AAAA:
+			if family == 6 && v.AAAA.To16() != nil && v.AAAA.To4() == nil {
+				found = append(found, rr)
+			}
+		}
+	}
+	if alias != nil && len(found) != 0 {
+		return nil, nil, fmt.Errorf("CNAME and addresses share an owner")
+	}
+	return alias, found, nil
+}
+
+func (s *Server) SetPolicyUpstream(address string) error {
+	if address == "" {
+		return nil
+	}
+	if _, _, err := net.SplitHostPort(address); err != nil {
+		return fmt.Errorf("invalid policy DNS upstream: %w", err)
+	}
+	s.handler.policyUpstream = address
+	// All raw fallbacks use the configured resolver, never host resolv.conf.
+	s.handler.nameservers = []string{address}
+	return nil
+}
