@@ -0,0 +1,142 @@
+package forwarder
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"io"
+	"math/big"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/adapters/gonet"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/link/loopback"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv4"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/tcp"
+)
+
+func TestTCPPolicyForwarding(t *testing.T) {
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	certTemplate := &x509.Certificate{SerialNumber: big.NewInt(1), DNSNames: []string{"api.example.test"}, NotBefore: time.Now().Add(-time.Minute), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, BasicConstraintsValid: true}
+	der, err := x509.CreateCertificate(rand.Reader, certTemplate, certTemplate, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cert, err := x509.ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	roots := x509.NewCertPool()
+	roots.AddCert(cert)
+	backend := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { _, _ = io.WriteString(w, "ok") }))
+	backend.TLS = &tls.Config{Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: key}}, MinVersion: tls.VersionTLS12}
+	backend.StartTLS()
+	defer backend.Close()
+	target, err := url.Parse(backend.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, portString, err := net.SplitHostPort(target.Host)
+	if err != nil {
+		t.Fatal(err)
+	}
+	n, err := strconv.Atoi(portString)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n < 1 || n > 65535 {
+		t.Fatal("invalid backend port")
+	}
+	port := uint16(n) //nolint:gosec // n is checked to be in the uint16 port range above.
+	policy := &types.EgressPolicy{Revision: "1", Allow: []types.EgressRule{{Protocol: "tcp", Domain: "api.example.test", Port: port}}}
+	holder, err := types.NewEgressPolicyHolder(policy, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer holder.Close()
+	holder.RecordDNS("api.example.test", []net.IPAddr{{IP: net.ParseIP("127.0.0.1")}})
+	s := stack.New(stack.Options{NetworkProtocols: []stack.NetworkProtocolFactory{ipv4.NewProtocol}, TransportProtocols: []stack.TransportProtocolFactory{tcp.NewProtocol}})
+	defer s.Close()
+	if e := s.CreateNIC(1, loopback.New()); e != nil {
+		t.Fatal(e)
+	}
+	source := tcpip.AddrFrom4([4]byte{10, 0, 2, 100})
+	if e := s.AddProtocolAddress(1, tcpip.ProtocolAddress{Protocol: ipv4.ProtocolNumber, AddressWithPrefix: source.WithPrefix()}, stack.AddressProperties{}); e != nil {
+		t.Fatal(e)
+	}
+	s.SetSpoofing(1, true)
+	s.SetPromiscuousMode(1, true)
+	s.SetRouteTable([]tcpip.Route{{Destination: header.IPv4EmptySubnet, NIC: 1}})
+	virtual := tcpip.AddrFrom4([4]byte{198, 51, 100, 42})
+	var mu sync.Mutex
+	fw := TCP(s, map[tcpip.Address]tcpip.Address{virtual: tcpip.AddrFrom4([4]byte{127, 0, 0, 1})}, &mu, false, 16, 2*time.Second, holder)
+	s.SetTransportProtocolHandler(tcp.ProtocolNumber, fw.HandlePacket)
+	dial := func(name string) (string, error) {
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer cancel()
+		c, e := gonet.DialContextTCP(ctx, s, tcpip.FullAddress{NIC: 1, Addr: virtual, Port: port}, ipv4.ProtocolNumber)
+		if e != nil {
+			return "", e
+		}
+		defer c.Close()
+		_ = c.SetDeadline(time.Now().Add(3 * time.Second))
+		tlsConn := tls.Client(c, &tls.Config{ServerName: name, RootCAs: roots, MinVersion: tls.VersionTLS12})
+		if e = tlsConn.Handshake(); e != nil {
+			return "", e
+		}
+		if _, e = io.WriteString(tlsConn, "GET / HTTP/1.0\r\nHost: api.example.test\r\n\r\n"); e != nil {
+			return "", e
+		}
+		data, e := io.ReadAll(tlsConn)
+		return string(data), e
+	}
+	got, err := dial("api.example.test")
+	if err != nil || !strings.Contains(got, "ok") {
+		t.Fatalf("allowed TLS: %q, %v", got, err)
+	}
+	if _, err := dial("other.example.test"); err == nil {
+		t.Fatal("wrong SNI was accepted")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	active, err := gonet.DialContextTCP(ctx, s, tcpip.FullAddress{NIC: 1, Addr: virtual, Port: port}, ipv4.ProtocolNumber)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer active.Close()
+	_ = active.SetDeadline(time.Now().Add(3 * time.Second))
+	secure := tls.Client(active, &tls.Config{ServerName: "api.example.test", RootCAs: roots, MinVersion: tls.VersionTLS12})
+	if err := secure.Handshake(); err != nil {
+		t.Fatalf("active flow: %v", err)
+	}
+	if err := holder.Update(&types.EgressPolicy{Revision: "2"}); err != nil {
+		t.Fatal(err)
+	}
+	_, err = secure.Read(make([]byte, 1))
+	if err == nil {
+		t.Fatal("active flow survived revocation")
+	}
+	if e, ok := err.(net.Error); ok && e.Timeout() {
+		t.Fatalf("revocation timed out: %v", err)
+	}
+	if _, err := dial("api.example.test"); err == nil {
+		t.Fatal("revoked TLS was accepted")
+	}
+}
